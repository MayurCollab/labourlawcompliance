# Frontend environment variables (Vite exposes only VITE_* to the client)

# API base URL used by axios and the Vite /api proxy target
VITE_API_URL=http://localhost:5000

# Public app URL (used for redirects, OAuth callbacks, etc.)
VITE_APP_URL=http://localhost:5190

# Error tracking (optional). Leave empty to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
