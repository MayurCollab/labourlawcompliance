# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/blueprint_mern

# Redis (rate-limit store + BullMQ email queue). Required in production.
# Local: install Redis and leave the default, or omit for in-memory/inline fallbacks.
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client
CLIENT_URL=http://localhost:5190

# Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
USER_WRITE_RATE_WINDOW=900000
USER_WRITE_RATE_MAX=60

# Auth
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_EXPIRY_MIN=1440
PASSWORD_RESET_EXPIRY_MIN=15

# Storage: 's3' (documents, generated PDFs, avatars). Form 5 templates stay on disk.
# Use 'local' only in automated tests.
STORAGE_DRIVER=s3

# Required for STORAGE_DRIVER=s3. Keep the bucket private — the API streams files.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# Database seeder (default admin account — change the password after first login!)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@1234

# SMTP (email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="ACC Labour Law Compliance <no-reply@example.com>"

# MSG91 WhatsApp (Form 5 document template)
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=918320455693
MSG91_TEMPLATE_NAME=ankit_chokshi_new
MSG91_TEMPLATE_NAMESPACE=f81e39d2_346b_4801_8a3d_b74b0141f1e2
MSG91_TEMPLATE_LANGUAGE=en
# MSG91_WHATSAPP_API_URL=https://api.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/
# GET, YYYY-MM-DD, max 3-day range (see https://docs.msg91.com/whatsapp/whatsapp-logs)
# MSG91_WHATSAPP_LOGS_URL=https://control.msg91.com/api/v5/report/logs/wa
# Optional: protect delivery webhook (query ?token=… or header x-webhook-secret)
# MSG91_WEBHOOK_SECRET=
# MSG91 dashboard URL for this app:
#   https://<host>/api/webhooks/whatsapp/status

# Swagger UI (/api-docs). Enabled automatically when NODE_ENV !== production.
# Set to true to expose docs in production (not recommended without auth).
ENABLE_SWAGGER=false

# When true, register responses include the raw verification token so e2e can
# verify without SMTP. NEVER enable in production.
EXPOSE_AUTH_TOKENS=false

# --- Observability ---

# Error tracking. Leave empty to disable Sentry entirely (the default locally).
SENTRY_DSN=
# Tag events with a build/commit so a regression points at a deploy.
SENTRY_RELEASE=
# Fraction of requests traced for performance. 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus scrape endpoint at GET /metrics. Off by default.
METRICS_ENABLED=false
# Optional shared secret. When set, /metrics requires: Authorization: Bearer <token>
METRICS_TOKEN=

# Log any MongoDB operation slower than this (ms). 0 disables slow-query logging.
DB_SLOW_QUERY_MS=200

# LibreOffice binary for legacy Excel Form 5 → PDF only.
# Bundled HTML templates use Puppeteer/Chromium (installed via npm) — no env var needed.
# If unset and soffice is not on PATH, Excel generate stores filled .xlsx instead.
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=

# On Linux production, Chromium also needs OS libs (libatk, libnss, …).
# Those are apt packages, not npm. With NODE_ENV=production, `npm install`
# runs scripts/installChromiumOsDeps.mjs (needs root or passwordless sudo).
# Force anytime: npm run setup:chromium-deps
# INSTALL_CHROMIUM_OS_DEPS=1
