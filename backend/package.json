{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ACC Labour Law Compliance API — Gujarat Professional Tax Form 5",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node src/database/seeders/seed.js",
    "verify:form5": "node scripts/verifyForm5Flow.mjs",
    "setup:s3": "node scripts/setupS3.mjs",
    "setup:chromium-deps": "node scripts/installChromiumOsDeps.mjs --force",
    "postinstall": "node scripts/installChromiumOsDeps.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.js",
    "test:coverage": "npm run test -- --coverage",
    "test:watch": "npm run test -- --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@sentry/node": "^10.68.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^22.0.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "p-retry": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pizzip": "^3.2.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  }
}
